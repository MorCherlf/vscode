{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "MorCherlf Agent",
	"version": "0.1.0",
	"identifier": "com.morcherlf.agent",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "MorCherlf Agent",
				"width": 1120,
				"height": 760,
				"minWidth": 720,
				"minHeight": 520
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
			"capabilities": [
				"main"
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": [
			"app"
		],
		"resources": {
			"resources/agent-host/": "agent-host/"
		},
		"icon": [
			"icons/icon.png",
			"icons/icon.icns"
		]
	}
}
